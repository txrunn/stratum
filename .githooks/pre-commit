#!/bin/sh
# Hard block on committing market/position data to a PUBLIC repo.
# Enable once per clone:  git config core.hooksPath .githooks
#
# .gitignore already excludes data/, but `git add -f` bypasses it and a leaked
# positions snapshot cannot be un-published. This is the backstop.

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

fail=0

# 1. Anything under data/ — no exceptions.
blocked=$(printf '%s\n' "$staged" | grep -E '^data/' || true)
if [ -n "$blocked" ]; then
    echo "BLOCKED: files under data/ are never committed:" >&2
    printf '  %s\n' $blocked >&2
    fail=1
fi

# 2. Local override configs that may hold account numbers.
blocked=$(printf '%s\n' "$staged" | grep -E '(^|/)\.env$|\.local\.ya?ml$' || true)
if [ -n "$blocked" ]; then
    echo "BLOCKED: runtime/secret config:" >&2
    printf '  %s\n' $blocked >&2
    fail=1
fi

# 3. Content scan for brokerage account-number shapes in staged text.
#    Robinhood accounts are ~8 uppercase alphanumerics; IBKR is "U" plus 7-8 digits.
#    This file is skipped: a scanner that greps its own patterns always self-matches.
for f in $staged; do
    case "$f" in
        .githooks/pre-commit) continue ;;
        LICENSE|*.png|*.jpg|*.gif|*.pdf|*.ipynb) continue ;;
    esac
    [ -f "$f" ] || continue
    if git show ":$f" 2>/dev/null | grep -qE '\bU[0-9]{7,8}\b|\b(account_number|accountId)["'"'"']?\s*[:=]\s*["'"'"'][A-Z0-9]{8,}' ; then
        echo "BLOCKED: possible account identifier in $f" >&2
        fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "Commit aborted. Override only if you are certain:  git commit --no-verify" >&2
    exit 1
fi

exit 0
